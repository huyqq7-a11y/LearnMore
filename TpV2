-- [[ NEKOHUB TELEPORT MODULE V4 - LOGIC FROM FREEISLANDS ]] --
local TeleportLib = {}

-- Cấu hình mặc định (Sẽ thay đổi khi bạn chỉnh trên Menu)
TeleportLib.Settings = {
    TeleportSpeed = 30,
    TeleportMethod = "MiniTp", -- Bổ sung phương thức để bạn chọn
    UseFloat = true,
    FarmDistance = 7,
    FarmMode = "Above" -- "Above", "Behind", "Front"
}

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- [[ BYPASS RƠI (FLOAT PART) TỪ FREEISLANDS ]] --
local Float_Part = Instance.new('Part')
Float_Part.Name = "Neko_Bypass_Part"
Float_Part.Parent = workspace
Float_Part.Transparency = 1
Float_Part.Size = Vector3.new(2, 0.2, 1.5)
Float_Part.Anchored = true

RunService.RenderStepped:Connect(function()
    if TeleportLib.Settings.UseFloat and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        Float_Part.CanCollide = true
        Float_Part.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, -3.1, 0)
    else
        Float_Part.CanCollide = false
        Float_Part.CFrame = CFrame.new(0, 99999, 0)
    end
end)

-- [[ LOGIC CHIA BƯỚC NHẢY (MINITP) TỪ FREEISLANDS ]] --
function TeleportLib.MiniTp(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local myPart = char.HumanoidRootPart
    local minDistance = 3 

    while (myPart.Position - targetPos).Magnitude > minDistance do
        local offset = targetPos - myPart.Position
        local distance = offset.Magnitude
        local step, waitTime

        -- LOGIC TÍNH TOÁN KHOẢNG CÁCH CHÍNH XÁC TỪ FREEISLANDS
        if distance <= 50 then
            step = Vector3.new(1, 2, 1); waitTime = 0.04
        elseif distance <= 30 then
            step = Vector3.new(1, 2, 1); waitTime = 0.005
        else
            step = Vector3.new(2.5, 4.5, 2.5); waitTime = 0.20
        end

        local steps = math.ceil(distance / step.Magnitude)
        local newStep = offset / steps

        for i = 1, steps do
            if not char or not myPart.Parent then break end
            myPart.CFrame = CFrame.new(myPart.Position + newStep)
            task.wait(waitTime)
        end
    end
    myPart.CFrame = CFrame.new(targetPos)
end

-- [[ TÍNH TOÁN TỌA ĐỘ THEO HƯỚNG ]] --
function TeleportLib.GetTargetCFrame(targetInstance)
    local pos = targetInstance.Position
    local cf = targetInstance.CFrame
    local dist = TeleportLib.Settings.FarmDistance

    if TeleportLib.Settings.FarmMode == "Above" then
        return pos + Vector3.new(0, dist, 0)
    elseif TeleportLib.Settings.FarmMode == "Behind" then
        return (cf * CFrame.new(0, 0, dist)).Position
    elseif TeleportLib.Settings.FarmMode == "Front" then
        return (cf * CFrame.new(0, 0, -dist)).Position
    end
    return pos
end

-- [[ HÀM DỊCH CHUYỂN CHÍNH - CHO PHÉP CHỌN PHƯƠNG THỨC ]] --
function TeleportLib.Teleport(target)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local targetPos
    if typeof(target) == "Instance" then
        targetPos = TeleportLib.GetTargetCFrame(target) -- Tự tính đứng trên/sau quái
    else
        targetPos = target
    end

    -- ĐÂY LÀ PHẦN SẼ CHẠY THEO DROPDOWN BẠN CHỌN TRÊN MENU
    local method = TeleportLib.Settings.TeleportMethod

    if method == "MiniTp" then
        TeleportLib.MiniTp(targetPos)
    elseif method == "Tween" then
        local distance = (char.HumanoidRootPart.Position - targetPos).Magnitude
        local info = TweenInfo.new(distance/TeleportLib.Settings.TeleportSpeed, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(char.HumanoidRootPart, info, {CFrame = CFrame.new(targetPos)})
        tween:Play()
    elseif method == "Instant" then
        char:SetPrimaryPartCFrame(CFrame.new(targetPos))
    end
end

return TeleportLib
